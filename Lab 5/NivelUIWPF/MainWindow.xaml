<Window x:Class="NivelUIWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NivelUIWPF"
        mc:Ignorable="d"
        Title="Evidenta Studenti" Height="600" Width="850">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Nume -->
        <Label Grid.Row="0" Grid.Column="0" Content="Nume:" VerticalAlignment="Center"/>
        <TextBox x:Name="txtNume" Grid.Row="0" Grid.Column="1" Margin="0,4" Height="28"/>

        <!-- Prenume -->
        <Label Grid.Row="1" Grid.Column="0" Content="Prenume:" VerticalAlignment="Center"/>
        <TextBox x:Name="txtPrenume" Grid.Row="1" Grid.Column="1" Margin="0,4" Height="28"/>

        <!-- Grupa -->
        <Label Grid.Row="2" Grid.Column="0" Content="Grupa:" VerticalAlignment="Center"/>
        <TextBox x:Name="txtGrupa" Grid.Row="2" Grid.Column="1" Margin="0,4" Height="28"/>

        <!-- Program Studiu -->
        <Label Grid.Row="3" Grid.Column="0" Content="Program studiu:" VerticalAlignment="Center"/>
        <ComboBox x:Name="cmbProgramStudiu" Grid.Row="3" Grid.Column="1" Margin="0,4" Height="28"
                  SelectedIndex="0">
            <ComboBoxItem Content="Licenta"/>
            <ComboBoxItem Content="Master"/>
            <ComboBoxItem Content="Doctorat"/>
        </ComboBox>

        <!-- Note -->
        <Label Grid.Row="4" Grid.Column="0" Content="Note (spatiu):" VerticalAlignment="Center"/>
        <TextBox x:Name="txtNote" Grid.Row="4" Grid.Column="1" Margin="0,4" Height="28"
                 ToolTip="Introduceti notele separate prin spatiu, ex: 8 9 7"/>

        <!-- Butoane actiuni -->
        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" Margin="0,8" HorizontalAlignment="Left">
            <Button x:Name="btnAdauga" Content="Adauga student"
                    Width="140" Height="30" Margin="0,0,8,0" Click="btnAdauga_Click"/>
            <Button x:Name="btnAfisareToti" Content="Afiseaza toti"
                    Width="120" Height="30" Margin="0,0,8,0" Click="btnAfisareToti_Click"/>
            <Button x:Name="btnAfisareFaraNote" Content="Fara note (&lt;2)"
                    Width="130" Height="30" Margin="0,0,8,0" Click="btnAfisareFaraNote_Click"/>
            <Button x:Name="btnStergeLog" Content="Sterge log"
                    Width="100" Height="30" Click="btnStergeLog_Click"/>
        </StackPanel>

        <!-- Separator -->
        <Separator Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,4"/>

        <!-- Lista studenti -->
        <ListBox x:Name="lstStudenti" Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                 Margin="0,4" FontFamily="Consolas" FontSize="13"/>

        <!-- Status bar -->
        <Label x:Name="lblStatus" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
               Content="Gata." Foreground="Gray" Margin="0,4"/>
    </Grid>
</Window>