<Window x:Class="NivelUIWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NivelUIWPF"
        mc:Ignorable="d"
        Title="Evidenta Studenti" Height="650" Width="950">

    <Window.Resources>
        <!-- Cerinta 4: converter pentru Binding RadioButton <-> enum ProgramStudiu -->
        <local:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
    </Window.Resources>

    <DockPanel>

        <!-- Meniu lateral -->
        <StackPanel DockPanel.Dock="Left" Width="140" Background="#F0F0F0">
            <Button x:Name="btnMeniuAdauga" Content="Adauga student"
                    Margin="5,10,5,5" Padding="5"
                    Click="btnMeniuAdauga_Click"/>
            <Button x:Name="btnMeniuCauta" Content="Cauta student"
                    Margin="5,5,5,5" Padding="5"
                    Click="btnMeniuCauta_Click"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Cerinta 1: Binding la proprietatea NumarStudenti -->
            <Label x:Name="lblNrStudenti" Grid.Row="0"
                   Content="{Binding NumarStudenti, StringFormat='Numar studenti: {0}'}"
                   FontWeight="Bold" Margin="5"/>

            <Grid Grid.Row="1">

                <!-- ===== PANEL ADAUGA ===== -->
                <StackPanel x:Name="panelAdauga" Visibility="Visible" Margin="10">

                    <Label Content="Nume:"/>
                    <TextBox x:Name="txtNume"
                             Text="{Binding StudentCurent.Nume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,2"/>
                    <TextBlock x:Name="tbErrNume" Foreground="Red" Visibility="Collapsed"/>

                    <Label Content="Prenume:"/>
                    <!-- Cerinta 2: Binding TwoWay pentru Prenume, similar cu Nume -->
                    <TextBox x:Name="txtPrenume"
                             Text="{Binding StudentCurent.Prenume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,2"/>
                    <TextBlock x:Name="tbErrPrenume" Foreground="Red" Visibility="Collapsed"/>

                    <Label Content="Note (separate prin spatiu):"/>
                    <!-- Cerinta 3: txtNote este populat din cod la selectia in DataGrid -->
                    <TextBox x:Name="txtNote" Margin="0,0,0,2"/>
                    <TextBlock x:Name="tbErrNote" Foreground="Red" Visibility="Collapsed"/>

                    <Label Content="Program studiu:"/>
                    <!-- Cerinta 4: Binding RadioButton <-> StudentCurent.ProgramSTD -->
                    <WrapPanel Margin="0,0,0,5">
                        <RadioButton x:Name="rbCalculatoare" Content="Calculatoare" Margin="0,0,8,0"
                                     IsChecked="{Binding StudentCurent.ProgramSTD,
                                                 Converter={StaticResource EnumToBoolConverter},
                                                 ConverterParameter=Calculatoare,
                                                 Mode=TwoWay}"/>
                        <RadioButton x:Name="rbAutomatica" Content="Automatica" Margin="0,0,8,0"
                                     IsChecked="{Binding StudentCurent.ProgramSTD,
                                                 Converter={StaticResource EnumToBoolConverter},
                                                 ConverterParameter=Automatica,
                                                 Mode=TwoWay}"/>
                        <RadioButton x:Name="rbElectronica" Content="Electronica" Margin="0,0,8,0"
                                     IsChecked="{Binding StudentCurent.ProgramSTD,
                                                 Converter={StaticResource EnumToBoolConverter},
                                                 ConverterParameter=Electronica,
                                                 Mode=TwoWay}"/>
                        <RadioButton x:Name="rbElectrotehnica" Content="Electrotehnica" Margin="0,0,8,0"
                                     IsChecked="{Binding StudentCurent.ProgramSTD,
                                                 Converter={StaticResource EnumToBoolConverter},
                                                 ConverterParameter=Electrotehnica,
                                                 Mode=TwoWay}"/>
                        <RadioButton x:Name="rbEnergetica" Content="Energetica" Margin="0,0,8,0"
                                     IsChecked="{Binding StudentCurent.ProgramSTD,
                                                 Converter={StaticResource EnumToBoolConverter},
                                                 ConverterParameter=Energetica,
                                                 Mode=TwoWay}"/>
                        <RadioButton x:Name="rbInginerieEconomica" Content="Ing. Economica" Margin="0,0,8,0"
                                     IsChecked="{Binding StudentCurent.ProgramSTD,
                                                 Converter={StaticResource EnumToBoolConverter},
                                                 ConverterParameter=InginerieEconomica,
                                                 Mode=TwoWay}"/>
                    </WrapPanel>

                    <Label Content="Discipline:"/>
                    <!-- Cerinta 3: CheckBox-urile sunt populate manual in SelectionChanged -->
                    <WrapPanel Margin="0,0,0,5">
                        <CheckBox x:Name="cbPIU"    Content="PIU"    Margin="0,0,10,0"
                                  Checked="Disciplina_CheckedChanged" Unchecked="Disciplina_CheckedChanged"/>
                        <CheckBox x:Name="cbPCLP"   Content="PCLP"   Margin="0,0,10,0"
                                  Checked="Disciplina_CheckedChanged" Unchecked="Disciplina_CheckedChanged"/>
                        <CheckBox x:Name="cbPOO"    Content="POO"    Margin="0,0,10,0"
                                  Checked="Disciplina_CheckedChanged" Unchecked="Disciplina_CheckedChanged"/>
                        <CheckBox x:Name="cbDCE"    Content="DCE"    Margin="0,0,10,0"
                                  Checked="Disciplina_CheckedChanged" Unchecked="Disciplina_CheckedChanged"/>
                        <CheckBox x:Name="cbFizica" Content="Fizica" Margin="0,0,10,0"
                                  Checked="Disciplina_CheckedChanged" Unchecked="Disciplina_CheckedChanged"/>
                    </WrapPanel>

                    <Label Content="Forma de finantare:"/>
                    <!-- Cerinta 4: Binding TwoWay pentru SelectedItem <-> StudentCurent.FormaFinantare -->
                    <ListBox x:Name="lbFormaFinantare" Height="65" Margin="0,0,0,5"
                             SelectedItem="{Binding StudentCurent.FormaFinantare, Mode=TwoWay}"/>

                    <WrapPanel Margin="0,5,0,5">
                        <Button x:Name="btnSalveaza"     Content="Salveaza"     Width="90" Margin="0,0,5,0"
                                Click="btnSalveaza_Click"/>
                        <Button x:Name="btnActualizeaza" Content="Actualizeaza" Width="90" Margin="0,0,5,0"
                                IsEnabled="False"
                                Click="btnActualizeaza_Click"/>
                        <Button x:Name="btnReseteaza"    Content="Reseteaza"    Width="90"
                                Click="btnReseteaza_Click"/>
                    </WrapPanel>

                    <TextBlock x:Name="tbWarningActualizare"
                               Text="Atentie: modificarile vor fi salvate la apasarea butonului Actualizeaza!"
                               Foreground="OrangeRed" TextWrapping="Wrap"
                               Visibility="Collapsed" Margin="0,0,0,5"/>

                    <DataGrid x:Name="dgStudenti" AutoGenerateColumns="False"
                              IsReadOnly="False" Height="180"
                              SelectionChanged="dgStudenti_SelectionChanged"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id"         Binding="{Binding IdStudent}"          Width="40"  IsReadOnly="True"/>
                            <DataGridTextColumn Header="Nume"       Binding="{Binding Nume}"                Width="100"/>
                            <DataGridTextColumn Header="Prenume"    Binding="{Binding Prenume}"             Width="100"/>
                            <DataGridTextColumn Header="Note"       Binding="{Binding NoteAfisare}"         Width="80"  IsReadOnly="True"/>
                            <DataGridTextColumn Header="Program"    Binding="{Binding ProgramSTD}"          Width="120" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Discipline" Binding="{Binding DisciplineAfisare}"   Width="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Finantare"  Binding="{Binding FormaFinantare}"      Width="80"  IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>

                <!-- ===== PANEL CAUTA ===== -->
                <StackPanel x:Name="panelCauta" Visibility="Collapsed" Margin="10">

                    <Label Content="Cauta dupa nume:"/>
                    <DockPanel Margin="0,0,0,5">
                        <Button x:Name="btnCauta" Content="Cauta" DockPanel.Dock="Right"
                                Width="70" Margin="5,0,0,0"
                                Click="btnCauta_Click"/>
                        <TextBox x:Name="txtCautareNume"/>
                    </DockPanel>

                    <Label x:Name="lblNrStudentiGasiti" Content="Numar studenti gasiti: 0"/>

                    <DataGrid x:Name="dgStudentiGasiti" AutoGenerateColumns="False"
                              IsReadOnly="True" Height="300" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id"         Binding="{Binding IdStudent}"          Width="40"/>
                            <DataGridTextColumn Header="Nume"       Binding="{Binding Nume}"                Width="100"/>
                            <DataGridTextColumn Header="Prenume"    Binding="{Binding Prenume}"             Width="100"/>
                            <DataGridTextColumn Header="Note"       Binding="{Binding NoteAfisare}"         Width="80"/>
                            <DataGridTextColumn Header="Program"    Binding="{Binding ProgramSTD}"          Width="120"/>
                            <DataGridTextColumn Header="Discipline" Binding="{Binding DisciplineAfisare}"   Width="150"/>
                            <DataGridTextColumn Header="Finantare"  Binding="{Binding FormaFinantare}"      Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                </StackPanel>

            </Grid>
        </Grid>
    </DockPanel>
</Window>
